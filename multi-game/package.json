{
  "name": "multi-game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel run dev --host 0.0.0.0",
    "dev:server": "pnpm --filter @mg/server run dev",
    "dev:client": "pnpm --filter @mg/client run dev",
    "build": "pnpm --filter @mg/client run build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.14.0"
}
